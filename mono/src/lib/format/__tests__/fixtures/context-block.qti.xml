    <correctResponse>
      <value><![CDATA[choice_1]]></value>
    </correctResponse>
    <mapping defaultValue="0">
      <mapEntry mapKey="choice_1" mappedValue="3"/>
      <mapEntry mapKey="choice_2" mappedValue="-1"/>
