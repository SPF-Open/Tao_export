  <itemBody>
    <div class="grid-row">
      <div class="col-12">
        <p>
          <strong>Vous disposez d'une table « employés » avec les colonnes suivantes : </strong>
        </p>
        <ul>
          <li>
            <strong>département </strong>
          </li>
          <li>
            <strong>salaire </strong>
          </li>
        </ul>
        <p>
          <strong>Vous souhaitez sélectionner les départements dont le salaire moyen est supérieur à 3 000 et ne prendre en compte que les employés dont le salaire est supérieur à 2 000. </strong>
        </p>
      </div>
    </div>
    <div class="grid-row">
      <div class="col-12">
        <choiceInteraction responseIdentifier="RESPONSE" shuffle="true" maxChoices="1" minChoices="0" orientation="vertical">
          <prompt>
            <div>
              <strong>Quelle requête SQL est correcte ?</strong>
            </div>
            <div>
              <div> </div>
            </div>
          </prompt>
          <simpleChoice identifier="choice_1" fixed="false" showHide="show">SELECT département, AVG(salaire) FROM employés WHERE salaire &gt; 2000 GROUP BY département HAVING AVG(salaire) &gt; 3000;</simpleChoice>
          <simpleChoice identifier="choice_2" fixed="false" showHide="show">SELECT département, AVG(salaire) FROM employés GROUP BY département WHERE salaire &gt; 2000 AND AVG(salaire) &gt; 3000;</simpleChoice>
          <simpleChoice identifier="choice_3" fixed="false" showHide="show">SELECT département, AVG(salaire) FROM employés WHERE AVG(salaire)&gt;3000 GROUP BY département HAVING salaire &gt; 2000;</simpleChoice>
          <simpleChoice identifier="choice_4" fixed="false" showHide="show">SELECT département, AVG(salaire) FROM employés GROUP BY département HAVING salaire &gt; 2000 AND AVG(salaire) &gt; 3000;</simpleChoice>
        </choiceInteraction>
      </div>
    </div>
  </itemBody>
  <responseProcessing template="http://www.imsglobal.org/question/qti_v2p2/rptemplates/map_response"/>
</assessmentItem>
